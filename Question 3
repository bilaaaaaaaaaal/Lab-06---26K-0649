#include <stdio.h>
int main() {
    int stock[10], minimum[10];
    int total_reorder = 0;
    int max_reorder = 0;
    int max_product = 0;
    for (int i = 0; i < 10; i++) {
        printf("Enter stock and minimum for product %d: ", i + 1);
        scanf("%d %d", &stock[i], &minimum[i]);
    }
    for (int i = 0; i < 10; i++) {
        if (stock[i] < minimum[i]) {
            int needed = minimum[i] - stock[i];
            total_reorder += needed;
            if (needed > max_reorder) {
                max_reorder = needed;
                max_product = i + 1;
            }
        }
    }
    for (int i = 0; i < 10; i++) {
        if (stock[i] < minimum[i]) {
            printf("Product %d needs to reorder: %d units[cite: 3]\n", i + 1, minimum[i] - stock[i]);
        }
    }
    printf("Product with largest reorder: Product %d[cite: 3]\n", max_product);
    printf("Total reorder quantity: %d[cite: 3]\n", total_reorder);
    return 0;
}
