#include <stdio.h>
int main() {
    int generations[10];
    generations[0] = 1;
    generations[1] = 1;
    for (int i = 2; i < 10; i++) {
        generations[i] = generations[i - 1] + generations[i - 2];
    }
    for (int i = 0; i < 10; i++) {
        printf("Generation %d = %d\n", i + 1, generations[i]);
    }
}
